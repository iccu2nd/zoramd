# MongoDB connection string (required)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/zorabot
MONGODB_URI=

# JWT secret for dashboard sessions (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# Server port
PORT=3000

# Base URL of this app (for callbacks / QR links if needed)
APP_URL=http://localhost:3000

# SociaBuzz username (for premium payments)
SOCIABUZZ_USERNAME=reyzdesu

# Optional: default owner number for system notifications
OWNER_NUMBER=6282322962313

# Email admin (pisah koma)
ADMIN_EMAILS=
